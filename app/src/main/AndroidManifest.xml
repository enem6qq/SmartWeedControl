<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kamera-Berechtigung + Feature (required=false = App installierbar ohne Kamera) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Nur Android 9 (API 28): Galerie-Export der Fotos in Pictures/SmartWeed.
         Ab Android 10 läuft der Export ohne Berechtigung über MediaStore;
         die Session-Daten selbst liegen im app-eigenen Speicher (Scoped Storage). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartWeed"
        tools:targetApi="31">

        <!-- MainActivity = Launcher => Login wird übersprungen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartWeed">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Admin-Anmeldung (schützt die Experten-Einstellungen; die App selbst
             ist ohne Anmeldung voll nutzbar) -->
        <activity
            android:name=".Login"
            android:exported="false"
            android:theme="@style/Theme.SmartWeed" />

        <!-- FileProvider für Zugriff/Share von Dateien (z.B. Bilder) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- AppCompat per-app language support service -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>
</manifest>

