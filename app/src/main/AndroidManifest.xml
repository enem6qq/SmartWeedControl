<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kamera-Berechtigung + Feature (required=false = App installierbar ohne Kamera) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Nur Android 9 (API 28): Galerie-Export der Fotos in Pictures/SmartWeed.
         Ab Android 10 läuft der Export ohne Berechtigung über MediaStore;
         die Session-Daten selbst liegen im app-eigenen Speicher (Scoped Storage). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- v1.9: Die Analyse läuft während der Auswertung als Vordergrund-Dienst
         (AnalysisKeepAliveService), damit Android sie nicht pausiert oder
         beendet, wenn das Display ausgeht oder die App kurz verlassen wird.
         - FOREGROUND_SERVICE(_DATA_SYNC): Vordergrund-Dienst (Typ ab Android 14 Pflicht)
         - WAKE_LOCK: CPU bleibt bei ausgeschaltetem Display wach
         - POST_NOTIFICATIONS: Hinweis "Analyse läuft" (ab Android 13 nur mit
           Zustimmung sichtbar; der Dienst läuft auch ohne sie) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup=false: Ohne Ausschlüsse ließe sich sonst per adb backup/
         restore das is_admin-Flag aus den SharedPreferences setzen und der
         Admin-Login ganz ohne Passwort umgehen. Nutzdaten (Fotos/Analysen)
         liegen ohnehin als Dateien vor und sind über die Galerie gesichert.
         (Die früher referenzierten backup_rules/data_extraction_rules waren
         leere Template-Vorlagen und wurden wegen allowBackup=false ohnehin
         ignoriert — entfernt.) -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartWeed"
        tools:targetApi="31">

        <!-- MainActivity = Launcher => Login wird übersprungen -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartWeed">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Admin-Anmeldung (schützt die Experten-Einstellungen; die App selbst
             ist ohne Anmeldung voll nutzbar) -->
        <activity
            android:name=".Login"
            android:exported="false"
            android:theme="@style/Theme.SmartWeed" />

        <!-- v1.9: hält die App während einer laufenden Analyse am Leben -->
        <service
            android:name=".AnalysisKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- AppCompat per-app language support service -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>
</manifest>

