<?xml version="1.0" encoding="utf-8"?>
<!-- v1.8: Textfarbe für Primär-Buttons (bg_primary_button). Deaktiviert ist
     der Hintergrund dunkelgrau (surface_light) — dunkler Text wäre dort
     unsichtbar, deshalb ein heller Ton. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/text_secondary"/>
    <item android:color="@color/text_on_primary"/>
</selector>
