<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Glow Layer -->
    <item
        android:left="-2dp"
        android:top="-2dp"
        android:right="-2dp"
        android:bottom="-2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <solid android:color="#0800E676"/>
        </shape>
    </item>

    <!-- Main Card Background with Gradient -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/card_background_dark"
                android:centerColor="#141D26"
                android:endColor="@color/card_background_glass"/>
        </shape>
    </item>

    <!-- Inner Highlight (Top Edge) -->
    <item
        android:top="0dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#15FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"/>
            <size android:height="80dp"/>
        </shape>
    </item>

    <!-- Border with Gradient Effect -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <stroke
                android:width="1dp"
                android:color="#2500E676"/>
        </shape>
    </item>

</layer-list>
