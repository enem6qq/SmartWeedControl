<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Subtle Shadow/Glow -->
    <item
        android:left="-1dp"
        android:top="-1dp"
        android:right="-1dp"
        android:bottom="-1dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="#05FFFFFF"/>
        </shape>
    </item>

    <!-- Main Background with Soft Gradient -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#12181F"
                android:centerColor="@color/background_elevated"
                android:endColor="#0A0F14"/>
        </shape>
    </item>

    <!-- Glass-like Top Highlight -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

    <!-- Subtle Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/border_muted"/>
        </shape>
    </item>

</layer-list>
