<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Glow Effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#0000E676"
                android:centerColor="#3000E676"
                android:endColor="#0000E676"/>
            <size android:height="4dp"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>

    <!-- Core Line -->
    <item
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#0000E676"
                android:centerColor="#8000E676"
                android:endColor="#0000E676"/>
            <size android:height="2dp"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>

</layer-list>
