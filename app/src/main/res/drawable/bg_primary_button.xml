<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Glow Effect (compressed) -->
            <item
                android:left="-2dp"
                android:top="-2dp"
                android:right="-2dp"
                android:bottom="-2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <solid android:color="#4000E676"/>
                </shape>
            </item>
            <!-- Main Button with Darker Gradient -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#00A844"
                        android:centerColor="#00C853"
                        android:endColor="#00A844"/>
                </shape>
            </item>
            <!-- Top Shine -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#30FFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#00FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Disabled State -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <solid android:color="@color/surface_light"/>
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <layer-list>
            <!-- Outer Glow -->
            <item
                android:left="-3dp"
                android:top="-3dp"
                android:right="-3dp"
                android:bottom="-3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="19dp"/>
                    <solid android:color="#2000E676"/>
                </shape>
            </item>
            <!-- Main Button with Vibrant Gradient -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="#00E676"
                        android:centerColor="#00D66A"
                        android:endColor="#00C853"/>
                </shape>
            </item>
            <!-- Glass Shine Effect -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#40FFFFFF"
                        android:centerColor="#15FFFFFF"
                        android:endColor="#00FFFFFF"/>
                </shape>
            </item>
            <!-- Subtle Inner Shadow at Bottom -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="90"
                        android:startColor="#20000000"
                        android:endColor="#00000000"/>
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
