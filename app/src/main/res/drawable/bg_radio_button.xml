<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Checked State with Glow -->
    <item android:state_checked="true">
        <layer-list>
            <!-- Outer Glow -->
            <item
                android:left="-2dp"
                android:top="-2dp"
                android:right="-2dp"
                android:bottom="-2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp"/>
                    <solid android:color="#2500E676"/>
                </shape>
            </item>
            <!-- Main Background with Gradient -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="#1A3D2E"
                        android:endColor="#0D2A1F"/>
                </shape>
            </item>
            <!-- Top Highlight -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#15FFFFFF"
                        android:endColor="#00FFFFFF"/>
                </shape>
            </item>
            <!-- Neon Border -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <stroke
                        android:width="2dp"
                        android:color="#6000E676"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default State -->
    <item>
        <layer-list>
            <!-- Main Background -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="#151D25"
                        android:endColor="#101820"/>
                </shape>
            </item>
            <!-- Top Highlight -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#08FFFFFF"
                        android:endColor="#00FFFFFF"/>
                </shape>
            </item>
            <!-- Border -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp"/>
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/border_default"/>
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
