<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Deep Dark Base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_dark"/>
        </shape>
    </item>

    <!-- Layer 2: Subtle Vertical Gradient Overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="180"
                android:startColor="#0D0D1419"
                android:centerColor="#00000000"
                android:endColor="#0D050A0E"/>
        </shape>
    </item>

    <!-- Layer 3: Large Green Orb - Top Right -->
    <item
        android:top="-200dp"
        android:right="-150dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="350dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#1500E676"
                android:endColor="#0000E676"/>
            <size android:width="500dp" android:height="500dp"/>
        </shape>
    </item>

    <!-- Layer 4: Cyan Orb - Bottom Left -->
    <item
        android:bottom="-250dp"
        android:left="-180dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#0D00E5FF"
                android:endColor="#0000E5FF"/>
            <size android:width="450dp" android:height="450dp"/>
        </shape>
    </item>

    <!-- Layer 5: Small Purple Accent - Center Right -->
    <item
        android:top="300dp"
        android:right="-100dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#0AE040FB"
                android:endColor="#00E040FB"/>
            <size android:width="250dp" android:height="250dp"/>
        </shape>
    </item>

    <!-- Layer 6: Subtle Top Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="500dp"
                android:centerX="0.5"
                android:centerY="0"
                android:startColor="#1200E676"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- Layer 7: Mesh-like Noise Texture Effect (subtle) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#03FFFFFF"
                android:centerColor="#00000000"
                android:endColor="#02FFFFFF"/>
        </shape>
    </item>

    <!-- Layer 8: Very Subtle Vignette Effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="800dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#00000000"
                android:endColor="#33000000"/>
        </shape>
    </item>

</layer-list>
