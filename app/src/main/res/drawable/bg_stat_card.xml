<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Subtle Outer Glow -->
    <item
        android:left="-1dp"
        android:top="-1dp"
        android:right="-1dp"
        android:bottom="-1dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <solid android:color="#0500E5FF"/>
        </shape>
    </item>

    <!-- Main Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#151D25"
                android:centerColor="#121920"
                android:endColor="#0F161C"/>
        </shape>
    </item>

    <!-- Top Highlight -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0CFFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

    <!-- Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="#1800E5FF"/>
        </shape>
    </item>

</layer-list>
