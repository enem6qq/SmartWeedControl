<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Neon Glow -->
    <item
        android:left="-3dp"
        android:top="-3dp"
        android:right="-3dp"
        android:bottom="-3dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp"/>
            <solid android:color="#1500E676"/>
        </shape>
    </item>

    <!-- Main Chip Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp"/>
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#152520"
                android:endColor="#0D1D18"/>
        </shape>
    </item>

    <!-- Top Glass Highlight -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp"/>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#15FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

    <!-- Neon Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp"/>
            <stroke
                android:width="1.5dp"
                android:color="#5000E676"/>
        </shape>
    </item>

</layer-list>
