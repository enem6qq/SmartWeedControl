<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer Glow Ring -->
    <item
        android:left="-4dp"
        android:top="-4dp"
        android:right="-4dp"
        android:bottom="-4dp">
        <shape android:shape="oval">
            <solid android:color="#3000E676"/>
        </shape>
    </item>

    <!-- Middle Glow Ring -->
    <item
        android:left="-2dp"
        android:top="-2dp"
        android:right="-2dp"
        android:bottom="-2dp">
        <shape android:shape="oval">
            <solid android:color="#5000E676"/>
        </shape>
    </item>

    <!-- Core Dot with Gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="8dp"
                android:centerX="0.3"
                android:centerY="0.3"
                android:startColor="#69F0AE"
                android:centerColor="@color/traktor_green"
                android:endColor="#00C853"/>
        </shape>
    </item>

    <!-- Inner Highlight -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="2dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#60FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>

</layer-list>
