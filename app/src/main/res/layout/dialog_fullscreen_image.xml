<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_dark">

    <!-- Dark Scrim -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark"/>

    <!-- Fullscreen Image (neutrale Beschreibung: kann Vorher- ODER
         Nachher-/Analysebild sein) -->
    <ImageView
        android:id="@+id/fullscreenImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/fullscreen_image_desc"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:layout_margin="16dp"/>

    <!-- Close Button -->
    <LinearLayout
        android:id="@+id/closeBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:background="@drawable/bg_card_soft"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/fullscreen_close">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:importantForAccessibility="no"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>
    </LinearLayout>
</FrameLayout>
