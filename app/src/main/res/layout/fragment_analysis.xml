<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Before Section Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_before"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <!-- Pick Before Button -->
            <Button
                android:id="@+id/buttonPickBefore"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_pick_before"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_on_primary"
                android:background="@drawable/bg_primary_button"
                android:foreground="@drawable/ripple_light"
                app:backgroundTint="@null"/>

            <!-- Image Preview -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_image_placeholder"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imageBefore"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/label_before"/>
            </FrameLayout>

            <!-- Image Name -->
            <TextView
                android:id="@+id/tvBeforeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/no_image_selected"
                android:textSize="13sp"
                android:textColor="@color/text_tertiary"/>

            <!-- Selected Images Header -->
            <TextView
                android:id="@+id/tvBeforeListHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/selected_before_images"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

            <!-- Before Container for multiple images -->
            <LinearLayout
                android:id="@+id/beforeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

        <!-- After Section Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_after"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <!-- Pick After Button -->
            <Button
                android:id="@+id/buttonPickAfter"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_pick_after"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_on_primary"
                android:background="@drawable/bg_primary_button"
                android:foreground="@drawable/ripple_light"
                app:backgroundTint="@null"/>

            <!-- Image Preview -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_image_placeholder"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/imageAfter"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/label_after"/>
            </FrameLayout>

            <!-- Image Name -->
            <TextView
                android:id="@+id/tvAfterName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/no_image_selected"
                android:textSize="13sp"
                android:textColor="@color/text_tertiary"/>

            <!-- Selected Images Header -->
            <TextView
                android:id="@+id/tvAfterListHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/selected_after_images"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="16dp"
                android:visibility="gone"/>

            <!-- After Container for multiple images -->
            <LinearLayout
                android:id="@+id/afterContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

        <!-- Analysis Mode Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analysis_mode_title"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/rgAnalysisMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbModeA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analysis_mode_a"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:paddingStart="8dp"
                    android:layout_marginBottom="8dp"/>

                <RadioButton
                    android:id="@+id/rbModeB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analysis_mode_b"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:paddingStart="8dp"
                    android:layout_marginBottom="8dp"/>

                <RadioButton
                    android:id="@+id/rbModeC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analysis_mode_c"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:paddingStart="8dp"/>
            </RadioGroup>

            <TextView
                android:id="@+id/tvModeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/analysis_mode_a_desc"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"/>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

        <!-- Run Analysis Button -->
        <Button
            android:id="@+id/buttonRunAnalysis"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_run_analysis"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_on_primary"
            android:background="@drawable/bg_primary_button"
            android:foreground="@drawable/ripple_light"
            app:backgroundTint="@null"/>

    </LinearLayout>
</ScrollView>
