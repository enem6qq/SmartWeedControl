<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Before Section Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_before"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <!-- Pick Before Button -->
            <Button
                android:id="@+id/buttonPickBefore"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_pick_before"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_on_primary"
                android:background="@drawable/bg_primary_button"
                android:foreground="@drawable/ripple_light"
                app:backgroundTint="@null"/>

            <!-- Auswahl-Status + "Alle entfernen" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBeforeName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/no_image_selected"
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary"/>

                <TextView
                    android:id="@+id/btnClearBefore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:text="@string/btn_clear_selection"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/traktor_green"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Ausgewählte Bilder als Kacheln (antippen = Vollbild, ✕ = entfernen) -->
            <HorizontalScrollView
                android:id="@+id/scrollBefore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/beforeContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

        <!-- After Section Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_after"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <!-- Pick After Button -->
            <Button
                android:id="@+id/buttonPickAfter"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/btn_pick_after"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_on_primary"
                android:background="@drawable/bg_primary_button"
                android:foreground="@drawable/ripple_light"
                app:backgroundTint="@null"/>

            <!-- Auswahl-Status + "Alle entfernen" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAfterName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/no_image_selected"
                    android:textSize="13sp"
                    android:textColor="@color/text_tertiary"/>

                <TextView
                    android:id="@+id/btnClearAfter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:text="@string/btn_clear_selection"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/traktor_green"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Ausgewählte Bilder als Kacheln (antippen = Vollbild, ✕ = entfernen) -->
            <HorizontalScrollView
                android:id="@+id/scrollAfter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/afterContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

        <!-- v1.8: Optionale Kontrollfläche (unbehandelt, gleiches Licht),
             standardmäßig eingeklappt. Ohne Kontrollbilder läuft die Analyse
             unverändert. -->
        <LinearLayout
            android:id="@+id/controlCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <!-- Kopfzeile: antippen = auf-/zuklappen -->
            <LinearLayout
                android:id="@+id/controlHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvControlTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/control_section_title"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/tvControlToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:text="@string/control_toggle_collapsed"
                    android:textSize="18sp"
                    android:textColor="@color/traktor_green"
                    android:importantForAccessibility="no"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/controlContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="14dp"
                    android:text="@string/control_section_hint"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_tertiary"/>

                <!-- Kontrolle vorher -->
                <Button
                    android:id="@+id/buttonPickControlBefore"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_pick_control_before"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/traktor_green"
                    android:background="@drawable/bg_secondary_button"
                    android:foreground="@drawable/ripple_light"
                    app:backgroundTint="@null"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvControlBeforeName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/no_image_selected"
                        android:textSize="13sp"
                        android:textColor="@color/text_tertiary"/>

                    <TextView
                        android:id="@+id/btnClearControlBefore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:text="@string/btn_clear_selection"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/traktor_green"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"/>
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/scrollControlBefore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/controlBeforeContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>

                <!-- Kontrolle nachher -->
                <Button
                    android:id="@+id/buttonPickControlAfter"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_pick_control_after"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="@color/traktor_green"
                    android:background="@drawable/bg_secondary_button"
                    android:foreground="@drawable/ripple_light"
                    app:backgroundTint="@null"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvControlAfterName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/no_image_selected"
                        android:textSize="13sp"
                        android:textColor="@color/text_tertiary"/>

                    <TextView
                        android:id="@+id/btnClearControlAfter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:text="@string/btn_clear_selection"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/traktor_green"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"/>
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/scrollControlAfter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/controlAfterContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

        <!-- Analysis Mode Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analysis_mode_title"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/rgAnalysisMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbModeA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analysis_mode_a"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:paddingStart="8dp"
                    android:layout_marginBottom="8dp"/>

                <RadioButton
                    android:id="@+id/rbModeB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analysis_mode_b"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:paddingStart="8dp"
                    android:layout_marginBottom="8dp"/>

                <RadioButton
                    android:id="@+id/rbModeC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analysis_mode_c"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:paddingStart="8dp"/>
            </RadioGroup>

            <TextView
                android:id="@+id/tvModeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/analysis_mode_a_desc"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"/>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>

        <!-- Run Analysis Button -->
        <Button
            android:id="@+id/buttonRunAnalysis"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_run_analysis"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_on_primary"
            android:background="@drawable/bg_primary_button"
            android:foreground="@drawable/ripple_light"
            app:backgroundTint="@null"/>

    </LinearLayout>
</ScrollView>
