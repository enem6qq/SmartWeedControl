<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootScrollSecond"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".CameraFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Decorative Background Orbs -->
        <View
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="-30dp"
            android:layout_gravity="end"
            android:background="@drawable/bg_floating_orb_blue"
            android:alpha="0.5"/>

        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="320dp"
            android:layout_marginStart="-25dp"
            android:background="@drawable/bg_floating_orb"
            android:alpha="0.4"/>

        <!-- Main Content -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Camera Preview Card -->
            <LinearLayout
                android:id="@+id/previewCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Section Title with Icon -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/traktor_blue"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/camera_preview_desc"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Camera Preview Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_camera_preview"
                    android:clipToOutline="true">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/previewView"
                        android:layout_width="match_parent"
                        android:layout_height="260dp"
                        android:background="@android:color/black"
                        android:contentDescription="@string/camera_preview_desc"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Action Buttons with Premium Styling -->
            <LinearLayout
                android:id="@+id/actionButtons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/previewCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Take Before Photo Button -->
                <Button
                    android:id="@+id/buttonTakePhotoBefore"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/btn_take_photo_before"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/traktor_green"
                    android:letterSpacing="0.02"
                    android:background="@drawable/bg_secondary_button"
                    android:foreground="@drawable/ripple_light"
                    android:elevation="6dp"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"/>

                <!-- Take After Photo Button -->
                <Button
                    android:id="@+id/buttonTakePhotoAfter"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/btn_take_photo_after"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/traktor_green"
                    android:letterSpacing="0.02"
                    android:background="@drawable/bg_secondary_button"
                    android:foreground="@drawable/ripple_light"
                    android:elevation="6dp"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"/>

                <!-- Import Image Button -->
                <Button
                    android:id="@+id/buttonImportImage"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/btn_import_image"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/traktor_green"
                    android:letterSpacing="0.02"
                    android:background="@drawable/bg_secondary_button"
                    android:foreground="@drawable/ripple_light"
                    android:elevation="6dp"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"/>

                <!-- Start Analysis Button (Primary) -->
                <Button
                    android:id="@+id/buttonStartAnalysis"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/btn_start_analysis"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/text_on_primary"
                    android:letterSpacing="0.02"
                    android:background="@drawable/bg_primary_button"
                    android:foreground="@drawable/ripple_light"
                    android:elevation="12dp"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>
</androidx.core.widget.NestedScrollView>
