<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Decorative Background Elements -->
    <View
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="-30dp"
        android:layout_gravity="end"
        android:background="@drawable/bg_floating_orb"
        android:alpha="0.5"/>

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="350dp"
        android:layout_marginStart="-40dp"
        android:background="@drawable/bg_floating_orb_blue"
        android:alpha="0.4"/>

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Premium Angle Display Card -->
        <LinearLayout
            android:id="@+id/angleCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_hero"
            android:padding="28dp"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp">

            <!-- Hinweis: Screen ist eine Vorschau, Funktion in Planung -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:text="@string/planned_badge"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:textColor="@color/status_warning"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_open_manual"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Large Angle Display with Glow -->
            <TextView
                android:id="@+id/manualAngleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/angle_placeholder"
                android:textSize="64sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="-0.03"
                android:shadowColor="@color/shadow_glow_green"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="25"/>

            <!-- Decorative Line -->
            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_decorative_line"/>
        </LinearLayout>

        <!-- Level Selection Card -->
        <LinearLayout
            android:id="@+id/levelCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/angleCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/level_medium"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="18dp"/>

            <RadioGroup
                android:id="@+id/levelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/levelLow"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/level_low"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_radio_button"
                    android:layout_marginEnd="8dp"/>

                <RadioButton
                    android:id="@+id/levelMedium"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/level_medium"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_radio_button"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>

                <RadioButton
                    android:id="@+id/levelHigh"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/level_high"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/bg_radio_button"
                    android:layout_marginStart="8dp"/>
            </RadioGroup>
        </LinearLayout>

        <!-- Start Button -->
        <Button
            android:id="@+id/manualStartButton"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:enabled="false"
            android:alpha="0.5"
            android:text="@string/btn_start"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_primary"
            android:letterSpacing="0.02"
            android:background="@drawable/bg_primary_button"
            android:foreground="@drawable/ripple_light"
            android:elevation="12dp"
            android:stateListAnimator="@null"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="28dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
