<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Decorative Background Elements -->
    <View
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="100dp"
        android:layout_marginStart="-50dp"
        android:background="@drawable/bg_floating_orb_blue"
        android:alpha="0.6"/>

    <View
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="end"
        android:layout_marginTop="300dp"
        android:layout_marginEnd="-30dp"
        android:background="@drawable/bg_floating_orb"
        android:alpha="0.4"/>

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Premium Status Card -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_hero"
            android:padding="32dp"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp">

            <!-- Status Chip with Neon Glow -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_status_chip"
                android:elevation="8dp"
                android:layout_marginBottom="24dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_status_dot"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_active"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/traktor_green"
                    android:letterSpacing="0.02"/>
            </LinearLayout>

            <!-- Large Angle Display with Glow -->
            <TextView
                android:id="@+id/angleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/angle_format"
                android:textSize="72sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:letterSpacing="-0.03"
                android:shadowColor="#5000E5FF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="30"/>

            <!-- Decorative Line -->
            <View
                android:layout_width="80dp"
                android:layout_height="3dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_decorative_line"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_desc"
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.01"/>
        </LinearLayout>

        <!-- Control Buttons at Bottom -->
        <LinearLayout
            android:id="@+id/controlButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="28dp">

            <!-- Primary Start/Cancel Button -->
            <Button
                android:id="@+id/startCancelButton"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:text="@string/btn_start"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:letterSpacing="0.02"
                android:background="@drawable/bg_primary_button"
                android:foreground="@drawable/ripple_light"
                android:elevation="12dp"
                android:stateListAnimator="@null"
                app:backgroundTint="@null"/>

            <!-- Settings Button -->
            <Button
                android:id="@+id/settingsButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:text="@string/action_settings"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/traktor_green"
                android:letterSpacing="0.02"
                android:background="@drawable/bg_secondary_button"
                android:foreground="@drawable/ripple_light"
                android:elevation="6dp"
                android:stateListAnimator="@null"
                app:backgroundTint="@null"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
