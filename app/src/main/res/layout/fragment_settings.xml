<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Info Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_soft"
            android:padding="16dp"
            android:text="@string/settings_info"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="3dp"/>

        <!-- Segmentierungsmethode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_method"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/rgMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbMethodExg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_method_exg"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:paddingStart="8dp"
                    android:layout_marginBottom="8dp"/>

                <RadioButton
                    android:id="@+id/rbMethodHsv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_method_hsv"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:paddingStart="8dp"/>
            </RadioGroup>
        </LinearLayout>

        <!-- Bildanalyse -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analysis_mode_title"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_min_size"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>

            <EditText
                android:id="@+id/etMinSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="number"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:importantForAutofill="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_h_low"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>

            <EditText
                android:id="@+id/etHueLow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="number"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:importantForAutofill="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_h_high"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>

            <EditText
                android:id="@+id/etHueHigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="number"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:importantForAutofill="no"/>
        </LinearLayout>

        <!-- CSC-Zielbereich -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/csc_hero_title"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_csc_low"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>

            <EditText
                android:id="@+id/etCscLow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:inputType="numberDecimal"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:importantForAutofill="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_csc_high"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>

            <EditText
                android:id="@+id/etCscHigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="numberDecimal"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:importantForAutofill="no"/>
        </LinearLayout>

        <!-- Buttons -->
        <Button
            android:id="@+id/buttonSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/settings_save"
            android:textStyle="bold"
            android:textColor="@color/text_on_primary"
            android:background="@drawable/bg_primary_button"
            android:foreground="@drawable/ripple_light"
            android:stateListAnimator="@null"/>

        <Button
            android:id="@+id/buttonResetSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/settings_reset"
            android:textStyle="bold"
            android:textColor="@color/traktor_green"
            android:background="@drawable/bg_secondary_button"
            android:foreground="@drawable/ripple_light"
            android:stateListAnimator="@null"/>

    </LinearLayout>
</ScrollView>
