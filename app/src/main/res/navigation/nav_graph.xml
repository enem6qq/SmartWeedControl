<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/HomeFragment">

    <fragment
        android:id="@+id/HomeFragment"
        android:name="com.example.smartweed.HomeFragment"
        android:label="@string/home_fragment_label"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_HomeFragment_to_CameraFragment"
            app:destination="@id/CameraFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_monitoringFragment"
            app:destination="@id/monitoringFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_manualFragment"
            app:destination="@id/manualFragment" />
        <action
            android:id="@+id/action_HomeFragment_to_trashFragment"
            app:destination="@id/trashFragment" />
    </fragment>

    <fragment
        android:id="@+id/CameraFragment"
        android:name="com.example.smartweed.CameraFragment"
        android:label="@string/camera_fragment_label"
        tools:layout="@layout/fragment_camera">

        <action
            android:id="@+id/action_CameraFragment_to_HomeFragment"
            app:destination="@id/HomeFragment" />
        <action
            android:id="@+id/action_CameraFragment_to_monitoringFragment"
            app:destination="@id/monitoringFragment" />
        <action
            android:id="@+id/action_CameraFragment_to_manualFragment"
            app:destination="@id/manualFragment" />
        <!-- Weiterleitung auf AnalysisFragment -->
        <action
            android:id="@+id/action_CameraFragment_to_AnalysisFragment"
            app:destination="@id/AnalysisFragment" />
    </fragment>

    <fragment
        android:id="@+id/monitoringFragment"
        android:name="com.example.smartweed.MonitoringFragment"
        android:label="@string/monitoring_fragment_label" />

    <fragment
        android:id="@+id/trashFragment"
        android:name="com.example.smartweed.TrashFragment"
        android:label="@string/trash_title"
        tools:layout="@layout/fragment_trash" />

    <fragment
        android:id="@+id/manualFragment"
        android:name="com.example.smartweed.ManualFragment"
        android:label="@string/manual_fragment_label" />

    <!-- AnalysisFragment mit Aktion zur Summary-Seite -->
    <fragment
        android:id="@+id/AnalysisFragment"
        android:name="com.example.smartweed.AnalysisFragment"
        android:label="@string/analysis_fragment_label"
        tools:layout="@layout/fragment_analysis">
        <action
            android:id="@+id/action_AnalysisFragment_to_SummaryFragment"
            app:destination="@id/SummaryFragment" />
    </fragment>

    <!-- SummaryFragment (Ergebnisseite) -->
    <fragment
        android:id="@+id/SummaryFragment"
        android:name="com.example.smartweed.SummaryFragment"
        android:label="@string/summary_fragment_label"
        tools:layout="@layout/fragment_summary" />

    <!-- Analyse-Einstellungen (Experten-Modus), erreichbar über das Menü -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.smartweed.SettingsFragment"
        android:label="@string/settings_fragment_label"
        tools:layout="@layout/fragment_settings" />
</navigation>
